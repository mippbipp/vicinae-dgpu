{
  description = "Per-app dGPU launch wrappers for Vicinae and NixOS";

  inputs = {
    nixpkgs.url = "github:nixos/nixpkgs/nixos-unstable";
    # nix-community/bun2nix#110: bun2nix 2.1.2 rejects the lockfileVersion 2
    # that bun 1.4 writes. Move back to nix-community/bun2nix once it merges.
    bun2nix = {
      url = "github:Mic92/bun2nix/0456acb1b7394fc14c414b056aa889df5124943a";
      inputs.nixpkgs.follows = "nixpkgs";
    };
  };

  outputs =
    {
      self,
      nixpkgs,
      bun2nix,
      ...
    }:
    let
      systems = [
        "x86_64-linux"
        "aarch64-linux"
      ];
      forAllSystems = f: nixpkgs.lib.genAttrs systems (system: f system nixpkgs.legacyPackages.${system});

      mkDgpu =
        system: pkgs:
        pkgs.callPackage ./nix/package.nix {
          bun2nix = bun2nix.packages.${system}.default;
        };
      homeManagerModule = import ./nix/hm.nix self.packages;
    in
    {
      packages = forAllSystems (
        system: pkgs:
        let
          dgpu = mkDgpu system pkgs;
        in
        {
          default = dgpu.cli;
          inherit (dgpu) cli extension;
        }
      );

      checks = forAllSystems (
        system: pkgs:
        let
          dgpu = mkDgpu system pkgs;
        in
        {
          inherit (dgpu) cli extension;
        }
      );

      devShells = forAllSystems (
        system: pkgs: {
          default = pkgs.mkShell {
            packages = [
              pkgs.bun
              bun2nix.packages.${system}.default
            ];
          };
        }
      );

      # bun.nix is generated by bun2nix; formatting it would fight the postinstall output.
      formatter = forAllSystems (
        system: pkgs: pkgs.nixfmt-tree.override { settings.global.excludes = [ "bun.nix" ]; }
      );

      homeManagerModules.default = homeManagerModule;
      homeModules.default = homeManagerModule;
    };
}
